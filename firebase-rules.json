// Regles de securite Invent'RTE
//
// Console Firebase > Realtime Database > onglet "Regles" > coller > Publier.
// Prerequis : Authentication > Sign-in method > Anonyme > Active.
//
// Principe : le droit d'ecriture est accorde element par element (une piece,
// une zone, un chantier), jamais sur une collection entiere. Firebase ne permet
// pas de retirer plus bas un droit accorde plus haut : autoriser l'ecriture sur
// "parts" reviendrait a autoriser l'effacement de tout l'inventaire d'un coup.
{
  "rules": {
    ".read": false,
    ".write": false,

    // Index leger des equipes, lu au demarrage.
    "teams": {
      ".read": "auth != null",
      "$team": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name'])",
        "name":      { ".validate": "newData.isString() && newData.val().length <= 60" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$autre":    { ".validate": false }
      }
    },

    // Rattachement des chaines isolantes au catalogue des achats. Partage par
    // toutes les equipes : une chaine est la meme partout. Les prix y vivent
    // parce que la base est fermee, contrairement au depot du code.
    "catalogueEB": {
      ".read": "auth != null",
      "chaines": {
        "$code": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['ref'])",
          "ref":         { ".validate": "newData.isString() && newData.val().length <= 20" },
          "designation": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "prix":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$autre":      { ".validate": false }
        }
      },

      // Materiel de portee : manchon de jonction et preformes par cable,
      // entretoises et balisage repertories a part.
      "cables": {
        "$cable": { ".write": "auth != null" }
      },
      "entretoises": {
        "$ref": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['ref'])",
          "ref":         { ".validate": "newData.isString() && newData.val().length <= 20" },
          "designation": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "prix":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "faisceau":    { ".validate": "newData.isString() && newData.val().length <= 20" },
          "ecartement":  { ".validate": "newData.isNumber()" },
          "type":        { ".validate": "newData.isString() && newData.val().length <= 20" },
          "acss":        { ".validate": "newData.isBoolean()" },
          "sectionMin":  { ".validate": "newData.isNumber()" },
          "sectionMax":  { ".validate": "newData.isNumber()" },
          "$autre":      { ".validate": false }
        }
      },
      "balises": {
        "$ref": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['ref'])",
          "ref":         { ".validate": "newData.isString() && newData.val().length <= 20" },
          "designation": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "prix":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "famille":     { ".validate": "newData.isString() && newData.val().length <= 10" },
          "sectionMin":  { ".validate": "newData.isNumber()" },
          "sectionMax":  { ".validate": "newData.isNumber()" },
          "$autre":      { ".validate": false }
        }
      }
    },

    "profiles": {
      ".read": "auth != null",

      "$team": {

        "meta": {
          ".write": "auth != null",
          "name":       { ".validate": "newData.isString() && newData.val().length <= 60" },
          "createdAt":  { ".validate": "newData.isNumber()" },
          "migratedAt": { ".validate": "newData.isNumber()" },
          "restoredAt": { ".validate": "newData.isNumber()" },
          "$autre":     { ".validate": false }
        },

        "parts": {
          "$part": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['id', 'name', 'qty'])",
            "id":       { ".validate": "newData.isNumber()" },
            "name":     { ".validate": "newData.isString() && newData.val().length <= 200" },
            "qty":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "alertQty": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "familyId": { ".validate": "newData.isNumber()" },
            "location": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "desc":     { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "hasImage": { ".validate": "newData.isBoolean()" },
            "hasDoc":   { ".validate": "newData.isBoolean()" },
            "cable":    { ".validate": "newData.isBoolean()" },
            "poids":    { ".validate": "newData.val() == 'leger' || newData.val() == 'lourd' || newData.val() == 'treslourd'" },

            // Rattachement au catalogue des achats, pour la generation d'une EB.
            "refEB":         { ".validate": "newData.isString() && newData.val().length <= 20" },
            "designationEB": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "prixEB":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$autre":   { ".validate": false }
          }
        },

        "families": {
          "$family": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id":     { ".validate": "newData.isNumber()" },
            "name":   { ".validate": "newData.isString() && newData.val().length <= 100" },
            "desc":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "color":  { ".validate": "newData.isString() && newData.val().length <= 20" },
            "$autre": { ".validate": false }
          }
        },

        "map": {
          // Plan compresse cote application (~300 Ko).
          // La limite bloque l'envoi accidentel d'une image brute.
          "image": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 3000000"
          },
          "markers": {
            "$marker": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['id', 'name'])",
              "id":     { ".validate": "newData.isNumber()" },
              "x":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "y":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "name":   { ".validate": "newData.isString() && newData.val().length <= 120" },
              "desc":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
              "$autre": { ".validate": false }
            }
          }
        },

        "thumbs": {
          "$part": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 60000"
          }
        },

        "media": {
          "$part": {
            ".write": "auth != null",
            "image":  { ".validate": "newData.isString() && newData.val().length <= 3000000" },
            "doc":    { ".validate": "newData.isString() && newData.val().length <= 8000000" },
            "$autre": { ".validate": false }
          }
        },

        "baskets": {
          "$basket": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id":        { ".validate": "newData.isNumber()" },
            "name":      { ".validate": "newData.isString() && newData.val().length <= 150" },
            "status":    { ".validate": "newData.val() == 'draft' || newData.val() == 'active'" },
            "createdAt": { ".validate": "newData.isNumber()" }
          }
        },

        // Journal en ajout seul : une entree ecrite ne peut plus etre ni
        // modifiee ni effacee, y compris par l'application elle-meme.
        "history": {
          "$entry": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['ts', 'text'])",
            "ts":     { ".validate": "newData.isNumber()" },
            "user":   { ".validate": "newData.isString() && newData.val().length <= 60" },
            "text":   { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$autre": { ".validate": false }
          }
        }
      }
    },

    // Ancienne structure d'avant la migration, conservee en lecture seule
    // comme filet de securite. Plus aucune ecriture n'est autorisee.
    "profilesData": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
